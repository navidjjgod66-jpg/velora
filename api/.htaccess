# MAISON AURELLE — محافظت از لایهٔ سرور (هاست اشتراکی / Apache + LiteSpeed)
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # جلوگیری از دسترسی مستقیم به فایل‌های داده و لاگ
  RewriteRule ^data/ - [F,L]
</IfModule>

<FilesMatch "\.(json|log|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<Files "bootstrap.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
