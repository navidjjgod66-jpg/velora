# ═══════════════════════════════════════════════════════════════════════════
# VELORA AURELLE · environment
# Copy to .env and fill in. .env must never be committed.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Required ──────────────────────────────────────────────────────────────
# Startup refuses to boot without these five, by name, in an error log.
VELORA_DB_NAME=
VELORA_DB_USER=
VELORA_DB_PASS=
# Password, not hash. It is hashed at first login; see VELORA_ADMIN_PASS_HASH.
VELORA_ADMIN_USER=
VELORA_ADMIN_PASS=
VELORA_APP_KEY=

# ─── Database ──────────────────────────────────────────────────────────────
VELORA_DB_HOST=127.0.0.1
VELORA_DB_PORT=3306

# ─── Storefront ────────────────────────────────────────────────────────────
# Absolute, no trailing slash. Used for canonicals, the sitemap, OG tags and
# the ZarinPal callback URL. robots.txt must name the same host.
VELORA_APP_URL=https://velora.maison
VELORA_TZ=Asia/Tehran

# ─── Gateway ───────────────────────────────────────────────────────────────
VELORA_ZARINPAL_MERCHANT=
VELORA_ZARINPAL_SANDBOX=true

# ─── SMS (OTP login) ───────────────────────────────────────────────────────
# Empty = OTP cannot be delivered and login is impossible. The dev OTP is
# then accepted only from loopback.
VELORA_MELI_API=
VELORA_MELI_FROM=

# ─── Postal lookup ─────────────────────────────────────────────────────────
VELORA_POSTAL_ENABLED=true
VELORA_POSTAL_API_KEY=
VELORA_POSTAL_API_TOKEN=
VELORA_POSTAL_CACHE_TTL=604800

# ─── Security ──────────────────────────────────────────────────────────────
# Registers a token that purges carts on deploy. Empty is a startup warning.
VELORA_INSTALL_TOKEN=
# Space- or comma-separated. Empty = any host header is refused on CSRF.
VELORA_ALLOWED_HOSTS=
# Comma-separated CIDRs. Empty = admin panel reachable from anywhere.
VELORA_ADMIN_IP_ALLOW=
# Comma-separated CIDRs whose X-Forwarded-For is believed. Empty = ignore XFF.
VELORA_TRUSTED_PROXIES=
# CIDRs the payment gateway may call back from. Empty = any, rate-limited.
VELORA_GATEWAY_CB_IPS=

# ─── Diagnostics ───────────────────────────────────────────────────────────
# Never enable in production: it puts OTP codes in the log.
VELORA_OTP_DEBUG=false
VELORA_LOG_LEVEL=info
